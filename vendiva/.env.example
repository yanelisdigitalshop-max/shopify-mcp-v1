# ─────────────────────────────────────────────────────────────────────────────
#  Vendiva — variables de entorno del servidor
#
#  En tu computadora: copia este archivo como ".env" y llena los valores ahí.
#  El archivo .env NO se sube al repositorio (está en .gitignore).
#  En producción: se ponen en la configuración segura del hosting, no en archivos.
#
#  REGLA: ninguna llave se pega en un chat ni se escribe en el código.
# ─────────────────────────────────────────────────────────────────────────────

# Paso 0 — Llave de Anthropic (Claude). La crea la dueña en console.anthropic.com
# y la pega SOLO aquí (o en la configuración segura del hosting).
ANTHROPIC_API_KEY=

# Modelo de Claude. Déjalo vacío para usar el recomendado (claude-opus-5-5).
ANTHROPIC_MODEL=

# Base de datos PostgreSQL. Obligatoria en producción.
# En tu computadora puedes dejarla vacía: la app crea una base local en .datos-locales/
# Ejemplo: postgres://usuario:clave@servidor:5432/vendiva?sslmode=require
DATABASE_URL=

# Dirección pública de la app, sin barra al final (solo producción).
# Ejemplo: https://app.vendiva.com
APP_ORIGIN=

# Puerto del servidor (el hosting suele ponerlo solo).
PORT=3000
