# ─────────────────────────────────────────────────────────────────────────────
#  Vendiva — variables de entorno del servidor
#
#  En tu computadora: copia este archivo como ".env" y llena los valores ahí.
#  El archivo .env NO se sube al repositorio (está en .gitignore).
#  En producción: se ponen en la configuración segura del hosting, no en archivos.
#
#  REGLA: ninguna llave se pega en un chat ni se escribe en el código.
# ─────────────────────────────────────────────────────────────────────────────

# Paso 0 — Llave de Anthropic (Claude). La crea la dueña en console.anthropic.com
# y la pega SOLO aquí (o en la configuración segura del hosting).
# (Si esta no está, la app también acepta el nombre de siempre: ANTHROPIC_API_KEY.)
VENDIVA_ANTHROPIC_API_KEY=

# Parte 3 — Llave de FastMoss (buscador de productos y tendencias). La crea la dueña en
# su cuenta de FastMoss (Console -> client_secret) y la pega SOLO aquí o en el hosting.
# Se envía a https://openapi.fastmoss.com como "Authorization: Bearer <client_secret>".
VENDIVA_FASTMOSS_CLIENT_SECRET=

# Parte 4 — Llave de la API de Runway (videos con IA, modelo Gen-4 Turbo). La crea la dueña en
# dev.runwayml.com (organización -> API Keys) y la pega SOLO aquí o en el hosting.
# Se envía a https://api.dev.runwayml.com como "Authorization: Bearer <llave>".
# Cada video de 10 segundos cuesta 0,50 USD de créditos de Runway.
VENDIVA_RUNWAY_API_KEY=

# Parte 4 — Llave de la API de ElevenLabs (SOLO la voz de IA que narra el guion del video).
# La crea la dueña en elevenlabs.io (perfil -> API Keys) y la pega SOLO aquí o en el hosting.
# Se envía a https://api.elevenlabs.io en la cabecera "xi-api-key".
VENDIVA_ELEVENLABS_API_KEY=

# Opcional: la voz de IA (femenina, español natural). Elígela en la Voice Library de ElevenLabs,
# agrégala a tu cuenta y pega aquí su "voice ID". Vacío = una voz prediseñada multilingüe.
VENDIVA_ELEVENLABS_VOICE_ID=

# Modelo de Claude. Déjalo vacío para usar el recomendado (claude-haiku-5-5).
ANTHROPIC_MODEL=

# Base de datos PostgreSQL. Obligatoria en producción.
# En tu computadora puedes dejarla vacía: la app crea una base local en .datos-locales/
# Ejemplo: postgres://usuario:clave@servidor:5432/vendiva?sslmode=require
DATABASE_URL=

# Dirección pública de la app, sin barra al final (solo producción).
# Ejemplo: https://app.vendiva.com
APP_ORIGIN=

# Puerto del servidor (el hosting suele ponerlo solo).
PORT=3000

# Parte 7 — Pagos con Stripe. SOLO LLAVES DE PRUEBA (empiezan con sk_test_).
# Las crea la dueña en dashboard.stripe.com con el "Modo de prueba" encendido
# (Desarrolladores -> Llaves de API) y las pega SOLO aquí o en el hosting.
# SEGURO: con una llave que no sea de prueba (sk_live_...) el servidor NO arranca.
VENDIVA_STRIPE_SECRET_KEY=
# El secreto del webhook (empieza con whsec_): Desarrolladores -> Webhooks, endpoint
# https://<tu-dominio>/api/pagos/webhook. Sin él, los pagos no se activan.
VENDIVA_STRIPE_WEBHOOK_SECRET=
# NO TOCAR. Solo se llena cuando la dueña apruebe por escrito los cobros reales.
# VENDIVA_PAGOS_REALES=

# Parte 8 — Avisos del teléfono (Firebase Cloud Messaging). La cuenta de servicio la crea la
# dueña en la consola de Firebase (Configuración -> Cuentas de servicio) y pega el JSON
# (entero o en base64) SOLO aquí o en el hosting.
VENDIVA_FIREBASE_CUENTA_SERVICIO=
# Parte 8 — Solo para `npm run cuenta:revisores` y `npm run app:preparar`.
# VENDIVA_REVISOR_CONTRASENA=
# VENDIVA_APP_URL=https://app.<dominio>
